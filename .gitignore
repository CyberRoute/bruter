# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Ignore IDE folders
.idea

# Frontend (web/) build artifacts and dependencies.
# web/dist is generated by `npm run build` and embedded into the Go binary at
# build time; it is intentionally not committed.
web/node_modules
web/dist